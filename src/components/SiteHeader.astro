---
interface Props {
  crumb?: string;
}
const { crumb } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div id="reading-progress" aria-hidden="true"></div>

<header class="header">
  <div class="header-inner">
    <div class="header-left">
      <a class="brand" href={base ? `${base}/` : '/'}>
        <span class="brand-lead">Backend</span>
        <span class="brand-slash">/</span>
        <span class="brand-sub">First Principles</span>
      </a>
      {crumb && (
        <div class="crumb-wrap">
          <span class="crumb-sep">/</span>
          <span class="crumb-label">{crumb}</span>
          <button id="nav-sidebar-toggle" class="header-sidebar-toggle" aria-label="Toggle sidebar" title="Toggle sidebar (full width mode, key: [)">
            <svg class="toggle-icon" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="12" height="12" rx="2" />
              <path d="M6 2v12" />
            </svg>
            <span class="toggle-text">Full Width</span>
          </button>
        </div>
      )}
    </div>

    <nav class="header-right">
      <div class="status-indicator">
        <span class="status-pulse"></span>
        <span class="status-text">18 Curated Chapters</span>
      </div>
      <span class="nav-dot" aria-hidden="true">·</span>
      <a class="nav-link" href={base ? `${base}/#curriculum` : '/#curriculum'}>Curriculum</a>
      <span class="nav-dot" aria-hidden="true">·</span>
      <a 
        class="nav-link" 
        href="https://github.com/AmanKashyapp07/Backendd" 
        target="_blank" 
        rel="noopener noreferrer"
      >
        GitHub
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 3h7v7M13 3 6 10" />
        </svg>
      </a>
    </nav>
  </div>
</header>

<script>
  // Dynamic reading progress bar
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const updateProgress = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight > 0) {
        const percent = Math.min(100, Math.max(0, (scrollY / docHeight) * 100));
        bar.style.width = `${percent}%`;
      }
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  // Sidebar toggle state & events
  const navSidebarToggle = document.getElementById('nav-sidebar-toggle');
  const updateToggleUI = () => {
    const isHidden = document.documentElement.classList.contains('sidebar-hidden');
    if (navSidebarToggle) {
      const textEl = navSidebarToggle.querySelector('.toggle-text');
      if (textEl) textEl.textContent = isHidden ? 'Show Sidebar' : 'Full Width';
      navSidebarToggle.setAttribute('aria-pressed', String(isHidden));
    }
  };

  if (navSidebarToggle) {
    navSidebarToggle.addEventListener('click', () => {
      const isHidden = document.documentElement.classList.toggle('sidebar-hidden');
      localStorage.setItem('backend_sidebar_hidden', String(isHidden));
      updateToggleUI();
      window.dispatchEvent(new CustomEvent('sidebar-toggled', { detail: { hidden: isHidden } }));
    });
    window.addEventListener('sidebar-toggled', updateToggleUI);
    updateToggleUI();
  }

  // Keyboard shortcut: '[' or '\' to toggle sidebar
  window.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === '[' || e.key === '\\') {
      e.preventDefault();
      const isHidden = document.documentElement.classList.toggle('sidebar-hidden');
      localStorage.setItem('backend_sidebar_hidden', String(isHidden));
      updateToggleUI();
      window.dispatchEvent(new CustomEvent('sidebar-toggled', { detail: { hidden: isHidden } }));
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(13, 15, 19, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    height: 52px;
  }

  .header-inner {
    max-width: 76rem;
    margin: 0 auto;
    height: 100%;
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    transition: max-width 200ms ease, padding 200ms ease;
  }

  :global(.sidebar-hidden) .header-inner {
    max-width: 100%;
    padding: 0 var(--space-6);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-size: var(--text-sm);
    white-space: nowrap;
    transition: opacity 140ms ease;
  }
  .brand:hover {
    opacity: 0.85;
  }

  .brand-lead {
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .brand-slash {
    color: var(--accent-amber);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 13px;
  }

  .brand-sub {
    font-weight: 500;
    color: var(--ink-muted);
    letter-spacing: -0.01em;
  }

  .crumb-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--ink-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .crumb-sep {
    opacity: 0.4;
  }

  .crumb-label {
    color: var(--accent-amber);
    font-weight: 600;
  }

  .header-sidebar-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: var(--space-2);
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: all 140ms ease;
  }
  .header-sidebar-toggle:hover {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.3);
    color: var(--accent-amber);
  }
  :global(.sidebar-hidden) .header-sidebar-toggle {
    background: rgba(245, 158, 11, 0.16);
    border-color: rgba(245, 158, 11, 0.4);
    color: var(--accent-amber);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 9px;
    border-radius: 99px;
    background: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.24);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--domain-emerald);
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .status-pulse {
    width: 5px;
    height: 5px;
    border-radius: 99px;
    background: var(--domain-emerald);
    box-shadow: 0 0 6px var(--domain-emerald);
  }

  @media (max-width: 768px) {
    .status-indicator {
      display: none;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 140ms ease;
  }
  .nav-link:hover {
    color: #ffffff;
  }

  .nav-dot {
    color: var(--line-strong);
    font-size: 10px;
  }

  @media (max-width: 640px) {
    .crumb-wrap {
      display: none;
    }
    .brand-sub {
      display: none;
    }
  }
</style>
